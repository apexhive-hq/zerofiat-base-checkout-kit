    "test:e2e": "node --test tests/e2e.test.mjs",
    "test": "node --test tests/*.test.mjs"
  },
  "dependencies": {
    "hono": "^4.7.10",
    "viem": "^2.30.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250501.0",
    "@types/node": "^22.15.0",
    "playwright": "1.64.1",
    "typescript": "^5.8.3"
  }
